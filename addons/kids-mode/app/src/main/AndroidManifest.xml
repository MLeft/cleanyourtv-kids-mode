<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The guard starts itself again after a power cycle: a boot receiver and a foreground keeper,
         and the enabled-accessibility setting written directly. WRITE_SECURE_SETTINGS is a
         development permission, granted once over ADB (see the README); without it the add-on
         falls back to the Accessibility settings screen. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/ic_kids"
        android:icon="@drawable/ic_kids"
        android:label="@string/app_name"
        android:theme="@style/Theme.KidsMode">

        <!-- The top-bar entry on the launcher (top_bar_apps) and the app tile in the library. -->
        <activity
            android:name=".KidsModeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The launcher starts this before opening its app library: the parent PIN, or silent OK
             within the configured grace window. -->
        <activity
            android:name=".KidsLibraryAuthActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.KidsAuth" />

        <!-- Counts screen-on time and draws the full-screen accessibility overlay. It asks for no
             window content and filters no keys; it only needs to exist and receive screen on/off. -->
        <service
            android:name=".KidsGuardService"
            android:exported="true"
            android:label="@string/guard_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kids_guard_service" />
        </service>

        <!-- Exported only to callers holding WRITE_SECURE_SETTINGS (the adb shell), for setup and tests. -->
        <receiver
            android:name=".KidsAdminReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.gathin.kidsmode.ADMIN" />
            </intent-filter>
        </receiver>

        <!-- After a power cycle MIUI force-stops the add-on and takes its accessibility service off
             the enabled list. This receiver puts both the keeper and the guard back; USER_UNLOCKED
             covers a set that boots straight into a locked user. -->
        <receiver
            android:name=".KidsBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- A low-priority foreground notification keeps the process alive while kids mode is on,
             so the guard can notice a dropped accessibility service and put it back. -->
        <service
            android:name=".KidsGuardKeeper"
            android:exported="false"
            android:stopWithTask="false" />

        <!-- JobScheduler is the last layer: a persisted 15-minute job restarts the keeper even if
             MIUI killed the process while the TV was on. -->
        <service
            android:name=".KidsGuardJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
