<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/kids_mode"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/kidsEnabledChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="26dp" />

        <TextView
            android:id="@+id/sessionLimitChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/waitLimitChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/dailyLimitChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/blockedStartChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/blockedEndChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/unmanagedStartChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/unmanagedEndChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/libraryGraceChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/changePinChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/kids_change_pin" />

        <TextView
            android:id="@+id/resetUsageChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/kids_reset_usage" />

        <TextView
            android:id="@+id/serviceChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/kidsUsageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#FFCFD8DC"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/kidsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/kids_hint"
            android:textColor="#FF90A4AE"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
