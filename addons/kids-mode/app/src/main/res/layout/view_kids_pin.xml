<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/kidsPinTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/kids_pin_title"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/kidsPinDots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:letterSpacing="0.25"
        android:text="○ ○ ○ ○"
        android:textColor="#FFB9E7C7"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/kidsPinError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="#FFFF8A80"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/kidsKey1" style="@style/KidsPinKey" android:text="1" />
        <TextView android:id="@+id/kidsKey2" style="@style/KidsPinKey" android:text="2" />
        <TextView android:id="@+id/kidsKey3" style="@style/KidsPinKey" android:text="3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView android:id="@+id/kidsKey4" style="@style/KidsPinKey" android:text="4" />
        <TextView android:id="@+id/kidsKey5" style="@style/KidsPinKey" android:text="5" />
        <TextView android:id="@+id/kidsKey6" style="@style/KidsPinKey" android:text="6" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView android:id="@+id/kidsKey7" style="@style/KidsPinKey" android:text="7" />
        <TextView android:id="@+id/kidsKey8" style="@style/KidsPinKey" android:text="8" />
        <TextView android:id="@+id/kidsKey9" style="@style/KidsPinKey" android:text="9" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView android:id="@+id/kidsKeyDel" style="@style/KidsPinKey" android:text="@string/kids_delete" />
        <TextView android:id="@+id/kidsKey0" style="@style/KidsPinKey" android:text="0" />
        <TextView android:id="@+id/kidsKeyOk" style="@style/KidsPinKey" android:text="@string/kids_ok" />
    </LinearLayout>
</merge>
